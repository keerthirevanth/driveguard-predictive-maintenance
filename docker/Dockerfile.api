FROM python:3.11-slim

WORKDIR /app
COPY requirements-serving.txt .
RUN pip install --no-cache-dir -r requirements-serving.txt

COPY src/ ./src/
COPY config/ ./config/
COPY models_store/ ./models_store/   # pre-built artifacts (python -m driveguard.models.finalize)
ENV PYTHONPATH=/app/src

EXPOSE 8000
CMD ["uvicorn", "driveguard.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]

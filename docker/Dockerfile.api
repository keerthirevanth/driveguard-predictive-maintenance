FROM python:3.11-slim

WORKDIR /app
COPY requirements-serving.txt .
RUN pip install --no-cache-dir -r requirements-serving.txt

COPY src/ ./src/
COPY config/ ./config/
# pre-built artifacts: run `python -m driveguard.models.finalize` before building
COPY models_store/ ./models_store/
ENV PYTHONPATH=/app/src

EXPOSE 8000
CMD ["uvicorn", "driveguard.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
